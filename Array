#include <stdio.h>

int main() {
    int n;

    // Ask user for array size
    printf("Enter the number of elements:");
    scanf("%d", &n);

    int arr[n];  // Declare array of size n

    // Input elements
    printf("Enter %d integers:", n);
    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Output elements
    printf("You entered:");

    for(int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
