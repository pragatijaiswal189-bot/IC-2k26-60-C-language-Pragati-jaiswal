#include <stdio.h>
int main()
{
    int a = 6, b = 3;

    printf("a&b = %d/n", 6&3)
    scanf("%d/n",&a);

    printf("a!b = %d/n", 6!3)
    scanf("%d/n",&a);

    printf("a^b = %d/n", 6^3)
    scanf("%d/n",&a);

    printf("a~b = %d/n",6~3)
    scanf("%d/n", &a);

    printf("a<< 1 = %d/n", 6<<1)
    scanf("%d/n",&a);

    printf("a>> 1 = %d/n", 6>>1)
    scanf("%d/n",&a);

    return 0;
}
