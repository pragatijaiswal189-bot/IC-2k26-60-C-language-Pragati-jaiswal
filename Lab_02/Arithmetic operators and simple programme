#include <stdio.h>
int main()
{
    int a = 9, b = 2;

    printf("Addition = %d/n", 9 + 2)
    scanf("%d/n", &a);

    printf("Subtraction = %d/n", 9 - 2)
    scanf("%d/n", &a);

    printf("Multiplication = %d/n", 9 * 2)
    scanf("%d/n", &a);

    printf("Division = %d/n", 9 / 2)
    scanf("%d/n", &a);

    printf("Remainder = %d/n", 9 % 2)
    scanf("%d/n", &a);

    return 0;
}


