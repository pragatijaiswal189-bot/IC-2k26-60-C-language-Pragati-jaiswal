#include <stdio>
int min()
{
    int n, t1 = 0, t2 = 1, nextTerm, sum_even = 0;
    printf("Enter the number of terms: ");
    scanf("%d", &n);
    printf("Fibonacci Series: ");

    for (int i = 1; i <= n; i++) {
        printf("%d ", t1);

        if (t1 % 2 == 0) {
            sum_even += t1;
        }
        nextTerm = t1 + t2;
        t1 = t2;
        t2 = nextTerm;
    }

     printf("\nSum of all even-valued terms: %d\n", sum_even);

    return 0;
}
