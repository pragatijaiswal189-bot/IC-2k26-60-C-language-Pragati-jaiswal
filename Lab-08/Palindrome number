#include <stdio.h>
int main()
{
    //input 121 <---> 121
    int n,c,s=0,r;
    printf("Enter any Number");
    scanf("%d",&n);
    c=n;
    while(n>0)
    {
         r=n%10;
         s=r+(s*10);
         n=n/10;
    }
     if(c==s){
     printf("Palindrome Number");
    }
     else{
     printf("Not Palindrome_Number");
    }
     return 0;
}
