#include <stdio.h>
#include <string.h>

int main() {
    char num[50];
    printf("Enter a number: ");
    scanf("%s", num);

    int len = strlen(num);
    int isPalindrome = 1;

    for (int i = 0; i < len / 2; i++) {
        if (num[i] != num[len - i - 1]) {
            isPalindrome = 0;
            break;
        }
    }

    if (isPalindrome){
        printf("%s is a palindrome ,num");
    }
    else{
        printf("%s is not a palindrome, num");
    }
    
    return 0;
}
