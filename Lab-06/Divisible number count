#include <stdio.h>

int main() {
    int n, count = 0;
    printf("Enter the value of n: ");
    scanf("%d", &n);
    printf("Numbers divisible by 3 but not by 5 (from 1 to %d):\n", n);
    
    for (int i = 1; i <= n; i++) {
        if (i % 3 == 0 && i % 5 != 0) {
            printf("%d ", i);
            count++;
        }
    }
    printf("\nTotal count: %d\n", count);
    return 0;
}

